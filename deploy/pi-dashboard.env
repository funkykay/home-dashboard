DASHBOARD_BIND=0.0.0.0:8080
DASHBOARD_DISPLAY=auto
DASHBOARD_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
DASHBOARD_ALSA=plughw:CARD=vc4hdmi,DEV=0
DASHBOARD_TTY=/dev/tty1
RUST_LOG=pi_dashboard=info
# Optional: use the device/connector names reported by modetest and /sys/class/drm.
# DASHBOARD_DRM_DEVICE=/dev/dri/card1
# DASHBOARD_CONNECTOR=HDMI-A-1
